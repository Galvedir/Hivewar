; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hivewar"
config/description="Insect trading card game - Phase 1 core match engine"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameLog="*res://scripts/autoload/game_log.gd"
CardDatabase="*res://scripts/autoload/card_database.gd"
GameState="*res://scripts/autoload/game_state.gd"
TurnManager="*res://scripts/autoload/turn_manager.gd"
CombatResolver="*res://scripts/autoload/combat_resolver.gd"
EffectResolver="*res://scripts/autoload/effect_resolver.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=940
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
